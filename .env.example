# Copy to .env on the server and fill in. Never commit the real .env.

# Where the site lives
PUBLIC_ORIGIN=https://nbtrainerdesk.duckdns.org
BASE_PATH=

# Google Sheets that feed Trainer Desk (blank = the IDs in server/config.js)
TRACKER_ID=
DUMPS_ID=

# Google sign-in (company accounts only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=nobroker.in
# Client the existing nbhr sheets token was made with (only needed for that old token)
SHEETS_CLIENT_ID=
SHEETS_CLIENT_SECRET=
SHEETS_ACCOUNT_HINT=nbhr@nobroker.in

# Who may open /admin/status and /admin/connect
SETUP_ADMINS=
# Trainer Desk admins in addition to ADMIN_EMAILS in server/config.js
DESK_EXTRA_ADMINS=

# E-mail
MAIL_TO=geetansh.kumar@nobroker.in
MAIL_TO_OVERRIDE=

# How often the input sheets are read (seconds), and how often app tabs are copied back to the tracker
REFRESH_SECONDS=60
MIRROR_SECONDS=300
SHEET_MIRROR=on

# WhatsApp after a claim: off | test | live
WA_MODE=off
WA_TEST_TO=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v25.0
WA_TEMPLATE=nht_trainer_assigned
WHATSAPP_ACCESS_TOKEN=
